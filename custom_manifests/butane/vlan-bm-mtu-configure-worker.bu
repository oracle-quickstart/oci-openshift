variant: openshift
version: 4.16.0
metadata:
  name: 00-worker-bm-vlan-mtu-9000
  labels:
    machineconfiguration.openshift.io/role: worker
storage:
  files:
  - mode: 0755
    path: "/usr/local/sbin/bm-mtu-configure.sh"
    contents:
      inline: |
        #!/bin/bash
        # Configure MTU=9000 on VLAN-backed bare metal interfaces.
        # br-ex can be created after this boot-time service first runs, so the
        # --wait-for-br-ex mode retries until OVN has created the bridge.

        set -euo pipefail

        TARGET_MTU=9000
        BR_EX_WAIT_ATTEMPTS="${BR_EX_WAIT_ATTEMPTS:-120}"
        BR_EX_WAIT_SECONDS="${BR_EX_WAIT_SECONDS:-5}"
        WAIT_FOR_BR_EX=false

        if [ "${1:-}" = "--wait-for-br-ex" ]; then
          WAIT_FOR_BR_EX=true
        fi

        set_link_mtu() {
          local dev="$1"
          local current_mtu

          current_mtu=$(ip link show "$dev" 2>/dev/null | grep -oP 'mtu \K[0-9]+' || echo 0)
          if [ "$current_mtu" -lt "$TARGET_MTU" ]; then
            echo "[ACTION] Setting MTU=$TARGET_MTU on $dev"
            ip link set dev "$dev" mtu "$TARGET_MTU"
            echo "[SUCCESS] Set MTU=$TARGET_MTU on $dev"
          else
            echo "[INFO] $dev already has MTU >= $TARGET_MTU"
          fi
        }

        set_ovs_mtu_request() {
          local iface="$1"

          if command -v ovs-vsctl &>/dev/null && ovs-vsctl --timeout=5 iface-to-br "$iface" &>/dev/null; then
            ovs-vsctl --timeout=5 set Interface "$iface" mtu_request="$TARGET_MTU"
            echo "[SUCCESS] Set OVS mtu_request=$TARGET_MTU on $iface"
          fi
        }

        vlans=$(ip -o link show type vlan | awk '{print $2}' | sed 's/:$//' | sed 's/@.*//' || true)
        if [ -z "$vlans" ]; then
          echo "[INFO] No VLAN interfaces found, exiting (no-op for VM workers)"
          exit 0
        fi

        echo "[INFO] Found VLAN interfaces: $vlans"

        # Process each VLAN interface
        for vlan in $vlans; do
          # Extract parent interface name
          # VLAN interfaces are named: parent.vlanid or parent.vlanid@parent
          # Strip everything from first dot onwards to get parent
          parent=$(echo "$vlan" | sed 's/\..*//')

          if [ -z "$parent" ] || [ "$parent" = "$vlan" ]; then
            echo "[WARN] Could not determine parent for $vlan, skipping"
            continue
          fi

          set_link_mtu "$parent"
          set_link_mtu "$vlan"
          set_ovs_mtu_request "$vlan"

          echo "[SUCCESS] MTU configuration complete for $parent and $vlan"
        done

        configure_br_ex() {
          if ! ip link show br-ex &>/dev/null; then
            return 1
          fi

          set_link_mtu br-ex
          set_ovs_mtu_request br-ex
          return 0
        }

        if [ "$WAIT_FOR_BR_EX" = true ]; then
          attempt=1
          while [ "$attempt" -le "$BR_EX_WAIT_ATTEMPTS" ]; do
            if configure_br_ex; then
              echo "[SUCCESS] br-ex MTU configuration complete"
              exit 0
            fi
            echo "[INFO] br-ex not found yet, retrying ($attempt/$BR_EX_WAIT_ATTEMPTS)"
            attempt=$((attempt + 1))
            sleep "$BR_EX_WAIT_SECONDS"
          done
          echo "[WARN] br-ex was not found before retry timeout"
          exit 0
        fi

        if ! configure_br_ex; then
          echo "[INFO] br-ex does not exist yet; bm-mtu-configure-br-ex.service will retry later"
        fi

        echo "[INFO] bm-mtu-configure.sh completed successfully"
        exit 0
systemd:
  units:
  - name: bm-mtu-configure.service
    enabled: true
    contents: |
      [Unit]
      Description=Configure MTU=9000 on VLAN-backed bare metal interfaces
      Documentation=https://github.com/oracle-quickstart/oci-openshift/issues/78
      After=NetworkManager.service oci-eval-user-data.service
      Before=ovs-configuration.service kubelet.service
      ConditionPathExists=/usr/local/sbin/bm-mtu-configure.sh

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/bm-mtu-configure.sh
      RemainAfterExit=yes
      StandardOutput=journal+console
      StandardError=journal+console

      [Install]
      WantedBy=multi-user.target
  - name: bm-mtu-configure-br-ex.service
    enabled: true
    contents: |
      [Unit]
      Description=Retry MTU=9000 on OVN br-ex after it is created
      Documentation=https://github.com/oracle-quickstart/oci-openshift/issues/78
      After=kubelet.service crio.service ovs-configuration.service bm-mtu-configure.service
      Wants=kubelet.service crio.service
      ConditionPathExists=/usr/local/sbin/bm-mtu-configure.sh

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/bm-mtu-configure.sh --wait-for-br-ex
      StandardOutput=journal+console
      StandardError=journal+console

      [Install]
      WantedBy=multi-user.target
